# Copy to .env.local to change it; .env.local is git-ignored.

# Where the browser would reach salon-backend, once this app talks to it. Phase 1 reads mock data
# only and never uses this — it's here so the later backend-wiring phase has no surprise. Next
# copies it into the browser code, so restart `npm run dev` or run `npm run build` again after
# changing it.
NEXT_PUBLIC_API_URL=http://localhost:8081

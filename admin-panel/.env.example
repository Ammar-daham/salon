# Copy to .env.local to change it; .env.local is git-ignored.

# Where the browser reaches salon-backend. Without it the panel uses http://localhost:8081, where the
# backend runs in development and under docker compose. Next copies it into the browser code, so
# restart `npm run dev` or run `npm run build` again after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8081

app:
  datasource:
    jdbc-url: jdbc:postgresql://localhost:5432/salondb
    username: add_your_user_name
    password: add_your_password_here
    pool-size: 30
  cors:
    allowed-origins: http://localhost:3000
  # Failed sign-ins (BE-22): at most this many on one email, and from one address, in any window.
  # These are the defaults, so the block can be left out.
  login-throttle:
    max-failures-per-account: 5
    max-failures-per-address: 20
    window: 15m
